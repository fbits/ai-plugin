{
  "name": "ResponderPerguntaFrete",
  "version": "1.0",
  "description": "Extrai intencao de uma pergunta sobre frete, despacha para a API correta e formata a resposta (v2 schema).",
  "start": "extrair_intencao",
  "inputSchema": {
    "type": "object",
    "required": ["loja", "prompt"],
    "properties": {
      "loja": { "type": "string" },
      "prompt": { "type": "string" }
    }
  },
  "steps": [
    {
      "id": "extrair_intencao",
      "type": "llm",
      "config": {
        "model": "Advanced",
        "responseFormat": "json",
        "outputSchema": {
          "type": "object",
          "required": ["Status", "MensagemUsuario"],
          "properties": {
            "Status": { "type": "string", "enum": ["Completo", "Incompleto"] },
            "MensagemUsuario": { "type": ["string", "null"] },
            "Tipo": { "type": ["string", "null"], "enum": ["Produtos", "Carrinho", "Pedido", null] },
            "Loja": { "type": ["string", "null"] },
            "CEP": { "type": ["integer", "null"] },
            "CarrinhoId": { "type": ["string", "null"] },
            "PedidoId": { "type": ["string", "null"] },
            "Produtos": {
              "type": ["array", "null"],
              "items": { "type": "object", "properties": { "ProdutoVarianteId": { "type": "integer" } } }
            }
          }
        },
        "useConversationContext": true,
        "systemPrompt": "Voce e um extrator de dados para cotacao de frete. A partir do prompt do usuario, identifique o tipo (Produtos | Carrinho | Pedido) e extraia os dados. Retorne APENAS JSON valido seguindo o schema. IMPORTANTE: CEP deve ser inteiro sem hifen (ex.: '01310-100' vira 1310100); ProdutoVarianteId deve ser inteiro. Regras de completude: para 'Produtos' sao obrigatorios CEP e ao menos um item em Produtos (se Loja nao vier, use a loja padrao); para 'Carrinho' sao obrigatorios CarrinhoId e CEP; para 'Pedido' e obrigatorio PedidoId (se Loja nao vier, use a loja padrao). Se algum dado obrigatorio estiver faltando ou se voce nao conseguir identificar o tipo, defina Status='Incompleto' e em MensagemUsuario escreva uma frase curta, amigavel e especifica pedindo exatamente o que falta. Se estiver tudo certo, defina Status='Completo' e MensagemUsuario=null.",
        "userPrompt": "Loja padrao: {{input.loja}}\nPrompt do usuario: {{input.prompt}}"
      }
    },
    {
      "id": "rotear_por_status",
      "type": "branch",
      "config": {
        "on": "{{steps.extrair_intencao.Status}}",
        "cases": { "Completo": "rotear_por_tipo", "Incompleto": "responder_dados_faltantes" }
      }
    },
    {
      "id": "rotear_por_tipo",
      "type": "branch",
      "config": {
        "on": "{{steps.extrair_intencao.Tipo}}",
        "cases": {
          "Produtos": "cotacao_por_produtos",
          "Carrinho": "cotacao_por_carrinho",
          "Pedido": "cotacao_por_pedido"
        },
        "default": "responder_tipo_desconhecido"
      }
    },
    {
      "id": "cotacao_por_produtos",
      "type": "http",
      "config": {
        "method": "POST",
        "url": "http://api.frete.fbits.net/checkout/cotacoes",
        "queryParams": { "decisionLog": "true" },
        "headers": { "Content-Type": "application/json" },
        "body": {
          "Loja": "{{steps.extrair_intencao.Loja}}",
          "CEP": "{{steps.extrair_intencao.CEP}}",
          "Produtos": "{{steps.extrair_intencao.Produtos}}"
        },
        "timeoutSeconds": 60
      }
    },
    {
      "id": "cotacao_por_carrinho",
      "type": "http",
      "config": {
        "method": "GET",
        "url": "http://api.frete.fbits.net/checkout/carrinhos/{{steps.extrair_intencao.CarrinhoId}}/cotacoes",
        "queryParams": { "cep": "{{steps.extrair_intencao.CEP}}", "decisionLog": "true" },
        "timeoutSeconds": 60
      }
    },
    {
      "id": "cotacao_por_pedido",
      "type": "http",
      "config": {
        "method": "GET",
        "url": "http://api.frete.fbits.net/checkout/cotacoes/lojas/{{steps.extrair_intencao.Loja}}/pedidos/{{steps.extrair_intencao.PedidoId}}",
        "queryParams": { "decisionLog": "true" },
        "timeoutSeconds": 60
      }
    },
    {
      "id": "responder_dados_faltantes",
      "type": "passthrough",
      "config": { "transform": "identity", "value": "{{steps.extrair_intencao.MensagemUsuario}}" }
    },
    {
      "id": "responder_tipo_desconhecido",
      "type": "constant",
      "config": { "value": "Nao identifiquei se sua pergunta e sobre produtos, carrinho ou pedido. Pode reformular?" }
    },
    {
      "id": "formatar_resposta",
      "type": "llm",
      "config": {
        "model": "Advanced",
        "responseFormat": "text",
        "systemPrompt": "Voce e um assistente de fretes amigavel. Resuma as cotacoes em markdown: para 'DecisionLogs', liste 'Step' como bullet principal e 'Message' como sub-item, substituindo True/False por Sim/Nao; exiba cotacoes em tabela com nome, prazo, valor, TabelaFreteId, CentroDistribuicao. Se houver erro com 'JaimitoException' valor 4, explique que e falta de estoque.",
        "userPrompt": "Pergunta original: {{input.prompt}}\n\nResultado por produtos: {{steps.cotacao_por_produtos}}\nResultado por carrinho: {{steps.cotacao_por_carrinho}}\nResultado por pedido: {{steps.cotacao_por_pedido}}"
      }
    },
    {
      "id": "saida",
      "type": "passthrough",
      "config": {
        "transform": "identity",
        "value": "{{steps.responder_dados_faltantes}}{{steps.responder_tipo_desconhecido}}{{steps.formatar_resposta.text}}"
      },
      "output": "final"
    }
  ],
  "edges": [
    { "from": "extrair_intencao", "to": "rotear_por_status", "condition": "success" },
    { "from": "rotear_por_status", "to": "rotear_por_tipo", "condition": "branch:Completo" },
    { "from": "rotear_por_status", "to": "responder_dados_faltantes", "condition": "branch:Incompleto" },
    { "from": "rotear_por_tipo", "to": "cotacao_por_produtos", "condition": "branch:Produtos" },
    { "from": "rotear_por_tipo", "to": "cotacao_por_carrinho", "condition": "branch:Carrinho" },
    { "from": "rotear_por_tipo", "to": "cotacao_por_pedido", "condition": "branch:Pedido" },
    { "from": "rotear_por_tipo", "to": "responder_tipo_desconhecido", "condition": "branch:default" },
    { "from": "cotacao_por_produtos", "to": "formatar_resposta", "condition": "success" },
    { "from": "cotacao_por_produtos", "to": "formatar_resposta", "condition": "error" },
    { "from": "cotacao_por_carrinho", "to": "formatar_resposta", "condition": "success" },
    { "from": "cotacao_por_carrinho", "to": "formatar_resposta", "condition": "error" },
    { "from": "cotacao_por_pedido", "to": "formatar_resposta", "condition": "success" },
    { "from": "cotacao_por_pedido", "to": "formatar_resposta", "condition": "error" },
    { "from": "responder_dados_faltantes", "to": "saida", "condition": "success" },
    { "from": "responder_tipo_desconhecido", "to": "saida", "condition": "success" },
    { "from": "formatar_resposta", "to": "saida", "condition": "success" },
    { "from": "formatar_resposta", "to": "saida", "condition": "error" }
  ]
}
